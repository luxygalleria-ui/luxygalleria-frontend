# Storefront environment. Copy to .env.local for local development (.env.local is never committed).
# Production builds use .env.production (committed, no secrets); Vercel project variables override it.

# API: local backend (luxy-backend, npm run dev). With or without /api/v1; the app normalises it.
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000/api/v1
# Live data instead (browsing is safe; checkout creates real orders and real payments):
# NEXT_PUBLIC_API_URL=https://api.luxygalleria.com/api/v1
# NEXT_PUBLIC_BACKEND_URL=https://api.luxygalleria.com/api/v1

# Google sign-in (public OAuth client ID)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_ADMIN_URL=https://admin.luxygalleria.com

# Local ICICI mock: no setting needed. When this storefront is open on localhost it follows the backend's mock
# payment page (plain http, no certificate warning); a deployed site never redirects to localhost.
